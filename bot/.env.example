# Telegram bot token from BotFather
TELEGRAM_TOKEN=your_bot_token_here

# Comma-separated list of allowed chat IDs
ALLOWED_CHAT_IDS=123456789

# Local callback server port used by the Python bot
BOT_SERVER_PORT=4000

# Local HTTP port used by the VS Code extension
EXT_SERVER_PORT=3000

# Max wait time for a Copilot response
REQUEST_TIMEOUT_SECONDS=600

# Telegram typing indicator refresh interval
TYPING_INTERVAL_SECONDS=4

# Optional absolute path override for the response file
# RESPONSE_FILE_PATH=C:/path/to/cipher_response.txt
